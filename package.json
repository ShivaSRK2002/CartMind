{
  "name": "cartmind-ai",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "dev": "concurrently -n web,api,admin -c blue,green,magenta \"npm:dev:web\" \"npm:dev:api\" \"npm:dev:admin\"",
    "db:migrate": "npm run migrate --workspace=apps/api",
    "db:seed": "npm run seed --workspace=apps/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspace=apps/api",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "ml:train": "python apps/ml/pipeline.py train",
    "ml:score": "python apps/ml/pipeline.py score",
    "ml:pipeline": "python apps/ml/pipeline.py all",
    "ml:export": "python apps/ml/databricks/01_export_from_postgres.py",
    "ml:medallion": "python apps/ml/databricks/02_medallion_pipeline.py --input apps/ml/databricks/data --output apps/ml/databricks/data/out"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
